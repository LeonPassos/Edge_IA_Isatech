# Tick de 1 ms, igual ao core Arduino: periodo de 10 ms do controle fica exato.
CONFIG_FREERTOS_HZ=1000

# Wi-Fi + MQTT nao cabem com folga na particao padrao de 1 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Console limpo como no Arduino: somente avisos e erros dos componentes do IDF.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
